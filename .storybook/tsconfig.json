{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowArbitraryExtensions": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "../stories/**/*.tsx"
  ]
}
