{
  "name": "@fwenthehunter/friendly-ui",
  "version": "0.3.0",
  "type": "module",
  "description": "Small server-first React components for Next.js.",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0"
  },
  "homepage": "https://martineboulanger.github.io/FriendlyUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartineBoulanger/FriendlyUI.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/MartineBoulanger/FriendlyUI/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "nextjs",
    "react",
    "react-server-components",
    "components",
    "ui",
    "tailwindcss"
  ],
  "license": "MIT"
}
